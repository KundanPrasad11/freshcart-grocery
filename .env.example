AUTH_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=freshcart
ADMIN_EMAIL=admin@example.com
RESEND_API_KEY=re_xxxxxxxxx
INVOICE_FROM="FreshCart <onboarding@resend.dev>"
INVOICE_TEST_RECIPIENT=your-resend-account-email@example.com
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret
APP_URL=http://localhost:3000
# Use only for local development/test; production must use Razorpay.
PAYMENTS_MODE=dummy
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token
