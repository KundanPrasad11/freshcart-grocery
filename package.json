{
  "name": "freshcart-grocery",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api --no-file-parallelism --maxWorkers=1",
    "test:coverage": "vitest run --coverage --no-file-parallelism --maxWorkers=1",
    "test:e2e": "node scripts/reset-test-db.mjs && playwright test",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^3.0.3",
    "mongodb": "^7.5.0",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.32",
    "razorpay": "^2.9.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vercel": "^59.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.9.6",
    "typescript": "5.5.4",
    "vitest": "^4.1.11"
  }
}
